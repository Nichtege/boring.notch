    "Usage limit, resets %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzungslimit, zurückgesetzt: %@"
          }
        }
      }
    },
    "Bars follow the real sound" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balken folgen dem echten Ton"
          }
        }
      }
    },
    "Needs the System Audio Recording permission. macOS shows its recording icon while music plays. The sound is only measured, never kept. Without sound, the bars animate." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Braucht die Berechtigung für die Systemaudio-Aufnahme. Solange Musik läuft, zeigt macOS sein Aufnahme-Symbol. Der Ton wird nur gemessen und nie gespeichert. Ohne Ton laufen die Balken als Animation."
          }
        }
      }
    },
    "Send this screen with the next message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diesen Bildschirm mit der nächsten Nachricht schicken"
          }
        }
      }
    },
    "A screenshot of this screen goes with your next message." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Screenshot dieses Bildschirms geht mit deiner nächsten Nachricht mit."
          }
        }
      }
    },
    "Allow Screen Recording for Boring Notch in System Settings, then restart the app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Boring Notch die Bildschirmaufnahme in den Systemeinstellungen und starte die App danach neu."
          }
        }
      }
    },
    "The screenshot couldn't be taken." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Screenshot konnte nicht aufgenommen werden."
