    "Enable Accessibility Access" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedienungshilfen-Zugriff aktivieren"
          }
        }
      }
    },
    "Accessibility access is required to replace system notifications with the Boring Notch HUD. This allows the app to intercept media and brightness events to display custom HUD overlays." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriff auf die Bedienungshilfen ist nötig, um die Systemeinblendungen durch das HUD von Boring Notch zu ersetzen. So kann die App Medien- und Helligkeitstasten abfangen und eigene Einblendungen zeigen."
          }
        }
      }
    },
    "Accessibility access is used only to improve media and brightness notifications. No data is collected or shared." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriff auf die Bedienungshilfen dient nur den Medien- und Helligkeitseinblendungen. Es werden keine Daten gesammelt oder weitergegeben."
          }
        }
      }
    },
