    "Stop waiting here. What Atlas already has still gets its answer in Starlane." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier nicht mehr warten. Was Atlas schon hat, beantwortet es trotzdem in Starlane."
          }
        }
      }
    },
