      }
    },
    "Opens a line under the notch. What you send goes to Atlas like a message from the dashboard." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet eine Zeile unter der Notch. Was du abschickst, geht an Atlas wie eine Nachricht aus dem Dashboard."
